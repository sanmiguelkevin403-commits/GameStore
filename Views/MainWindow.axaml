<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="GameStore.Views.MainWindow"
        Title="GameStore - Gestor de videojuegos"
        Width="1050" Height="700"
        MinWidth="850" MinHeight="600"
        Background="#111827">
  <Grid RowDefinitions="Auto,*" Margin="24">
    <StackPanel Grid.Row="0" Spacing="5" Margin="0,0,0,20">
      <TextBlock Text="GAMESTORE" FontSize="28" FontWeight="Bold" Foreground="#A78BFA"/>
      <TextBlock Text="Administra tu colección de videojuegos" FontSize="14" Foreground="#CBD5E1"/>
    </StackPanel>

    <Grid Grid.Row="1" ColumnDefinitions="330,*">
      <Border Grid.Column="0" Background="#1F2937" CornerRadius="12" Padding="18">
        <StackPanel Spacing="10">
          <TextBlock Text="DATOS DEL VIDEOJUEGO" FontSize="15" FontWeight="Bold" Foreground="White"/>
          <TextBlock Text="Nombre" Foreground="#CBD5E1"/>
          <TextBox x:Name="NameBox" Watermark="Ej. Minecraft"/>
          <TextBlock Text="Género" Foreground="#CBD5E1"/>
          <TextBox x:Name="GenreBox" Watermark="Ej. Aventura"/>
          <TextBlock Text="Plataforma" Foreground="#CBD5E1"/>
          <TextBox x:Name="PlatformBox" Watermark="Ej. PC, PlayStation, Xbox"/>
          <TextBlock Text="Precio" Foreground="#CBD5E1"/>
          <TextBox x:Name="PriceBox" Watermark="Ej. 59900"/>
          <TextBlock Text="Estado" Foreground="#CBD5E1"/>
          <ComboBox x:Name="StatusBox" SelectedIndex="0">
            <ComboBoxItem Content="Pendiente"/>
            <ComboBoxItem Content="Jugando"/>
            <ComboBoxItem Content="Completado"/>
          </ComboBox>
          <Button Content="Guardar videojuego" Click="Add_Click" Background="#7C3AED" Foreground="White"/>
          <Button Content="Actualizar seleccionado" Click="Update_Click"/>
          <Button Content="Limpiar formulario" Click="Clear_Click"/>
          <Button Content="Eliminar seleccionado" Click="Delete_Click" Background="#991B1B" Foreground="White"/>
          <TextBlock x:Name="MessageText" TextWrapping="Wrap" Foreground="#FDE68A" Margin="0,8,0,0"/>
        </StackPanel>
      </Border>

      <Border Grid.Column="1" Background="#1F2937" CornerRadius="12" Padding="18">
        <Grid RowDefinitions="Auto,*">
          <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="10" Margin="0,0,0,14">
            <TextBlock Text="MI COLECCIÓN" FontSize="17" FontWeight="Bold" Foreground="White" VerticalAlignment="Center"/>
            <Button Content="Actualizar lista" Click="Refresh_Click"/>
          </StackPanel>
          <ListBox x:Name="GamesList" Grid.Row="1" SelectionChanged="GamesList_SelectionChanged"
                   Background="#111827" Foreground="White">
            <ListBox.ItemTemplate>
              <DataTemplate>
                <Border Padding="12" Margin="4" Background="#273449" CornerRadius="8">
                  <StackPanel Spacing="4">
                    <TextBlock Text="{Binding Name}" FontSize="16" FontWeight="Bold" Foreground="White"/>
                    <TextBlock Text="{Binding Genre}" Foreground="#C4B5FD"/>
                    <TextBlock Text="{Binding Platform}" Foreground="#CBD5E1"/>
                    <TextBlock Text="{Binding Price, StringFormat='Precio: ${0:N2}'}" Foreground="#CBD5E1"/>
                    <TextBlock Text="{Binding Status}" Foreground="#86EFAC"/>
                  </StackPanel>
                </Border>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
        </Grid>
      </Border>
    </Grid>
  </Grid>
</Window>
